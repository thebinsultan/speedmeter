<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <UseWinForms>true</UseWinForms>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <AssemblyName>NetSpeedMonitor</AssemblyName>
    <RootNamespace>NetSpeedMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>NetSpeed Monitor</Product>
    <Description>Lightweight Windows taskbar network speed monitor</Description>
    <Company>NetSpeed Monitor Contributors</Company>
    <Copyright>Copyright (c) 2026 NetSpeed Monitor Contributors</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetSpeedMonitor.Core\NetSpeedMonitor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\icon.ico" />
    <None Include="Resources\icon.png" />
    <None Include="Resources\icon.svg" />
  </ItemGroup>
</Project>
